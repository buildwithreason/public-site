---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ReadingBehaviour from "../components/ReadingBehaviour.astro";
import type { Project } from "../lib/content";
import type { MarkdownHeading } from "astro";

interface Props {
  project: Project;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { title, description, year, status, tech, repo, demo, draft } = project.data;
---

<BaseLayout title={title} description={description} noindex={draft}>
  <ReadingBehaviour />

  <div class="wrap project-shell">
    <aside class="meta-rail">
      <dl>
        <dt>Status</dt>
        <dd>{status}</dd>

        <dt>Year</dt>
        <dd>{year}</dd>

        {tech.length > 0 && (
          <>
            <dt>Built with</dt>
            <dd class="rail-tech">{tech.map((t) => <Tag label={t} />)}</dd>
          </>
        )}

        {(repo || demo) && (
          <>
            <dt>Links</dt>
            <dd class="rail-links">
              {repo && <a href={repo} target="_blank" rel="noopener">Source</a>}
              {demo && <a href={demo} target="_blank" rel="noopener">Demo</a>}
            </dd>
          </>
        )}
      </dl>
    </aside>

    <article class="column">
      <header class="project-header">
        <p class="eyebrow">Project</p>
        <h1>{title}</h1>
        <p class="standfirst">{description}</p>

        <div class="inline-meta">
          <span>{status}</span><span aria-hidden="true">·</span><span>{year}</span>
        </div>

        {tech.length > 0 && (
          <div class="tech">{tech.map((t) => <Tag label={t} />)}</div>
        )}

        {(repo || demo) && (
          <div class="links">
            {repo && <a href={repo} target="_blank" rel="noopener">Source</a>}
            {demo && <a href={demo} target="_blank" rel="noopener">Demo</a>}
          </div>
        )}
      </header>

      <div class="toc-inline">
        <TableOfContents headings={headings} />
      </div>

      <div class="prose" data-reading-body>
        <slot />
      </div>

      <footer class="project-footer">
        <div class="share">
          <button type="button" data-copy-link>Copy link</button>
          <a href="/projects">All projects &rarr;</a>
        </div>
      </footer>
    </article>

    <aside class="rail toc-rail">
      <div class="rail-inner">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Same three zones as an article: metadata | write-up | contents. */
  .project-shell {
    display: grid;
    grid-template-columns: minmax(0, var(--content-max));
    justify-content: center;
    align-items: start;
    column-gap: var(--space-2xl);
  }

  .rail,
  .meta-rail {
    position: sticky;
    top: var(--space-l);
    padding-top: calc(var(--space-xl) + 0.5rem);
    max-height: calc(100vh - var(--space-l) * 2);
    overflow-y: auto;
  }

  .meta-rail,
  .toc-rail { display: none; }
  .toc-inline { display: block; }

  @media (min-width: 74rem) {
    .project-shell {
      grid-template-columns: minmax(0, var(--content-max)) minmax(0, 15rem);
    }
    .toc-rail { display: block; }
    .toc-inline { display: none; }
  }

  @media (min-width: 90rem) {
    .project-shell {
      grid-template-columns: minmax(0, var(--rail)) minmax(0, var(--content-max)) minmax(0, 15rem);
      justify-content: space-between;
      column-gap: var(--space-xl);
    }
    .meta-rail { display: block; }
    .column .inline-meta,
    .column .tech,
    .column .links { display: none; }
  }

  .meta-rail dl { margin: 0; font-family: var(--font-sans); font-size: 0.78rem; }
  .meta-rail dt {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .meta-rail dd { margin: 0.2rem 0 var(--space-s); color: var(--ink-secondary); }
  .rail-tech { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .rail-links { display: flex; flex-direction: column; gap: 0.3rem; }
  .meta-rail a {
    color: var(--ink-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .meta-rail a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .inline-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--space-s);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .project-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: var(--space-xs);
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-m);
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-s);
    font-size: 0.875rem;
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }

  .links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .project-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  .share {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .share button,
  .share a {
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .share button:hover,
  .share a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
