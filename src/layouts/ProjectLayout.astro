---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import type { Project } from "../lib/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, year, status, tech, repo, demo, draft } = project.data;
---

<BaseLayout title={title} description={description} noindex={draft}>
  <article class="wrap">
    <header class="project-header measure">
      <p class="eyebrow">Project · {status} · {year}</p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>

      {tech.length > 0 && (
        <div class="tech">
          {tech.map((t) => <Tag label={t} />)}
        </div>
      )}

      {(repo || demo) && (
        <div class="links">
          {repo && <a href={repo} target="_blank" rel="noopener">Source</a>}
          {demo && <a href={demo} target="_blank" rel="noopener">Demo</a>}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="project-footer measure">
      <p><a href="/projects">&larr; All projects</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  /* The whole page is the reading column, centred rather than pinned left. */
  article {
    --page-max: 46rem;
  }

  .project-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-top: var(--space-xs);
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-m);
  }

  .links {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-s);
    font-size: 0.875rem;
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }

  .links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .project-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  .project-footer a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .project-footer a:hover {
    color: var(--accent);
  }
</style>
