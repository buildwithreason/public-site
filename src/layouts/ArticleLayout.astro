---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Comments from "../components/Comments.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostNavigation from "../components/PostNavigation.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import {
  formatDate,
  isoDate,
  readingTime,
  slugify,
  getArticles,
  getAdjacent,
  getRelated,
  type Article,
} from "../lib/content";
import { siteConfig } from "../config/site";
import type { MarkdownHeading } from "astro";

interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { title, description, date, updated, category, tags, image, canonical, draft } =
  article.data;

const showUpdated = updated && updated.valueOf() > date.valueOf();
const showComments = article.data.comments && !draft;

const all = await getArticles();
const adjacent = getAdjacent(all, article.id);
const related = getRelated(article, all, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: isoDate(date),
  ...(showUpdated ? { dateModified: isoDate(updated!) } : {}),
  author: { "@type": "Person", name: siteConfig.name, jobTitle: siteConfig.role },
  publisher: { "@type": "Organization", name: siteConfig.brand },
  mainEntityOfPage: new URL(`/writing/${article.id}`, siteConfig.url).href,
  articleSection: category,
  keywords: tags.join(", "),
};
---

<BaseLayout
  title={title}
  description={description}
  image={image ?? `/writing/${article.id}/og.png`}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  canonicalOverride={canonical}
  noindex={draft}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />

  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <div class="wrap article-shell">
    {/* Left rail on very wide screens. Duplicates the byline and footer
        metadata, but exactly one of the two is ever displayed. */}
    <aside class="meta-rail">
      <dl>
        <dt>Published</dt>
        <dd><time datetime={isoDate(date)}>{formatDate(date)}</time></dd>

        {showUpdated && (
          <>
            <dt>Updated</dt>
            <dd>{formatDate(updated!)}</dd>
          </>
        )}

        <dt>Reading time</dt>
        <dd>{readingTime(article.body)}</dd>

        <dt>Filed under</dt>
        <dd>
          <a href={`/writing/categories/${slugify(category)}`}>{category}</a>
        </dd>

        {tags.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd class="rail-tags">
              {tags.map((t) => (
                <a href={`/writing/tags/${slugify(t)}`}>{t}</a>
              ))}
            </dd>
          </>
        )}
      </dl>

      <button type="button" data-copy-link class="rail-copy">Copy link</button>
    </aside>

    <article class="column">
      <header class="article-header">
        <p class="eyebrow">
          <a href={`/writing/categories/${slugify(category)}`}>{category}</a>
        </p>
        <h1>{title}</h1>
        <p class="standfirst">{description}</p>

        <div class="byline">
          <span>{siteConfig.name}</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(article.body)}</span>
        </div>

        {showUpdated && <p class="updated">Updated {formatDate(updated!)}</p>}

        {draft && (
          <p class="draft-notice">
            This is an unpublished draft. It is excluded from the production build.
          </p>
        )}
      </header>

      {/* Narrow screens get the contents list inline, above the article. */}
      <div class="toc-inline">
        <TableOfContents headings={headings} />
      </div>

      <div class="prose" data-article-body>
        <slot />
      </div>

      <footer class="article-footer">
        {tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => <Tag label={t} href={`/writing/tags/${slugify(t)}`} />)}
          </div>
        )}

        {canonical && (
          <p class="canonical-note">
            Originally published at <a href={canonical} rel="canonical">{new URL(canonical).hostname}</a>.
          </p>
        )}

        <div class="share">
          <button type="button" data-copy-link>Copy link</button>
          <a href="/writing">All writing &rarr;</a>
        </div>
      </footer>

      <PostNavigation adjacent={adjacent} />
      <RelatedPosts posts={related} />

      {showComments && <Comments term={`writing/${article.id}`} />}
    </article>

    {/* Wide screens get a sticky rail alongside the text. */}
    <aside class="rail toc-rail">
      <div class="rail-inner">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  /* Reading progress. Fixed, 2px, purely decorative. */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 20;
    background: transparent;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.08s linear;
  }

  /* Three zones on a wide screen: metadata, text, contents. The text column
     never grows past its reading measure — the extra width goes to the rails,
     which is the whole point. Rails drop away one at a time as space runs out.

       >= 90rem  meta | text | contents
       >= 74rem         text | contents
       <  74rem         text  (contents inline above it, meta in the footer)
  */
  .article-shell {
    display: grid;
    grid-template-columns: minmax(0, var(--content-max));
    justify-content: center;
    align-items: start;
    column-gap: var(--space-2xl);
  }

  .rail,
  .meta-rail {
    position: sticky;
    top: var(--space-l);
    padding-top: calc(var(--space-xl) + 0.5rem);
    max-height: calc(100vh - var(--space-l) * 2);
    overflow-y: auto;
  }

  .meta-rail,
  .toc-rail {
    display: none;
  }

  .toc-inline { display: block; }

  @media (min-width: 74rem) {
    .article-shell {
      grid-template-columns: minmax(0, var(--content-max)) minmax(0, 15rem);
    }
    .toc-rail { display: block; }
    .toc-inline { display: none; }
  }

  @media (min-width: 90rem) {
    .article-shell {
      grid-template-columns: minmax(0, var(--rail)) minmax(0, var(--content-max)) minmax(0, 15rem);
      justify-content: space-between;
      column-gap: var(--space-xl);
    }
    .meta-rail { display: block; }

    /* The rail now carries this information; don't say it twice. */
    .column .byline,
    .column .updated,
    .column .tags,
    .column .share button {
      display: none;
    }
  }

  /* Metadata rail */
  .meta-rail dl {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }

  .meta-rail dt {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .meta-rail dd {
    margin: 0.15rem 0 var(--space-s);
    color: var(--ink-secondary);
  }

  .meta-rail a {
    color: var(--ink-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .meta-rail a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .rail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.6rem;
  }

  .rail-copy {
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    cursor: pointer;
  }

  .rail-copy:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .article-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
    max-width: var(--content-max);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover { color: var(--accent); }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-top: var(--space-xs);
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-m);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .byline span:first-child { color: var(--ink-secondary); }

  .updated,
  .canonical-note {
    margin-top: var(--space-xs);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .draft-notice {
    margin-top: var(--space-s);
    padding: 0.6rem 0.9rem;
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--accent);
  }

  .article-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .share {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-m);
    font-size: 0.85rem;
  }

  .share button,
  .share a {
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .share button:hover,
  .share a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Heading anchors and code copy buttons are injected by script below. */
  .prose :global(.heading-anchor) {
    margin-left: 0.35rem;
    color: var(--ink-faint);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor:focus) {
    opacity: 1;
  }

  .prose :global(.code-wrap) {
    position: relative;
  }

  .prose :global(.code-copy) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.2rem 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--ink-muted);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .prose :global(.code-wrap:hover .code-copy),
  .prose :global(.code-copy:focus) {
    opacity: 1;
  }

  .prose :global(.code-copy:hover) {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  // ---- Reading progress ----------------------------------------------------
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  const body = document.querySelector<HTMLElement>("[data-article-body]");

  if (bar && body) {
    const update = () => {
      const start = body.offsetTop;
      const span = body.offsetHeight - window.innerHeight;
      const read = window.scrollY - start;
      const pct = span > 0 ? Math.min(1, Math.max(0, read / span)) : 0;
      bar.style.width = `${pct * 100}%`;
    };
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update, { passive: true });
  }

  // ---- Anchor links on headings -------------------------------------------
  for (const h of document.querySelectorAll<HTMLElement>(".prose h2[id], .prose h3[id]")) {
    const a = document.createElement("a");
    a.className = "heading-anchor";
    a.href = `#${h.id}`;
    a.textContent = "#";
    a.setAttribute("aria-label", `Link to section: ${h.textContent ?? ""}`);
    h.appendChild(a);
  }

  // ---- Copy buttons on code blocks ----------------------------------------
  for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
    const wrap = document.createElement("div");
    wrap.className = "code-wrap";
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "code-copy";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Press ⌘C";
      }
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
    wrap.appendChild(btn);
  }

  // ---- Copy link -----------------------------------------------------------
  // There are two: one in the metadata rail, one in the article footer. Only
  // one is visible at any width, but both need wiring.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-link]")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(location.href.split("#")[0]!);
        btn.textContent = "Link copied";
      } catch {
        btn.textContent = "Copy failed";
      }
      setTimeout(() => (btn.textContent = "Copy link"), 1600);
    });
  }

  // ---- Contents scroll spy -------------------------------------------------
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");

  if (links.length && "IntersectionObserver" in window) {
    const bySlug = new Map<string, HTMLAnchorElement[]>();
    for (const link of links) {
      const slug = link.dataset.tocLink!;
      bySlug.set(slug, [...(bySlug.get(slug) ?? []), link]);
    }

    const visible = new Set<string>();
    const order = [...bySlug.keys()];

    const paint = () => {
      const active = order.find((s) => visible.has(s));
      for (const [slug, nodes] of bySlug) {
        for (const n of nodes) {
          if (slug === active) n.setAttribute("aria-current", "true");
          else n.removeAttribute("aria-current");
        }
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        paint();
      },
      // Bias towards the heading nearest the top of the viewport.
      { rootMargin: "0px 0px -70% 0px" }
    );

    for (const slug of order) {
      const el = document.getElementById(slug);
      if (el) io.observe(el);
    }
  }
</script>
