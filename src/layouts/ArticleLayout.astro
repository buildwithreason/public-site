---
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import Comments from "../components/Comments.astro";
import { formatDate, isoDate, readingTime, type Article } from "../lib/content";
import { siteConfig } from "../config/site";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, date, updated, category, tags, image, canonical, draft } =
  article.data;

// Drafts are not published, so there is nothing to discuss yet.
const showComments = article.data.comments && !draft;

const showUpdated = updated && updated.valueOf() > date.valueOf();

// Structured data so search engines read the piece as an article, not a page.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: isoDate(date),
  ...(showUpdated ? { dateModified: isoDate(updated!) } : {}),
  author: {
    "@type": "Person",
    name: siteConfig.name,
    jobTitle: siteConfig.role,
  },
  publisher: { "@type": "Organization", name: siteConfig.brand },
  mainEntityOfPage: new URL(`/writing/${article.id}`, siteConfig.url).href,
  articleSection: category,
  keywords: tags.join(", "),
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  canonicalOverride={canonical}
  noindex={draft}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />

  <article class="wrap">
    <header class="article-header measure">
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>

      <div class="byline">
        <span>{siteConfig.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(article.body)}</span>
      </div>

      {showUpdated && (
        <p class="updated">Updated {formatDate(updated!)}</p>
      )}

      {draft && <p class="draft-notice">This is an unpublished draft. It is excluded from the production build.</p>}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-footer measure">
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => <Tag label={t} />)}
        </div>
      )}

      {canonical && (
        <p class="canonical-note">
          Originally published at <a href={canonical} rel="canonical">{new URL(canonical).hostname}</a>.
        </p>
      )}

      <p class="back"><a href="/writing">&larr; All writing</a></p>
    </footer>

    {showComments && <Comments term={`writing/${article.id}`} />}
  </article>
</BaseLayout>

<style>
  /* The whole page is the reading column, centred rather than pinned left. */
  article {
    --page-max: 46rem;
  }

  .article-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-top: var(--space-xs);
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-m);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .byline span:first-child {
    color: var(--ink-secondary);
  }

  .updated,
  .canonical-note {
    margin-top: var(--space-xs);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .draft-notice {
    margin-top: var(--space-s);
    padding: 0.6rem 0.9rem;
    border: 1px dashed var(--accent);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--accent);
  }

  .article-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .back {
    margin-top: var(--space-m);
    font-size: 0.875rem;
  }

  .back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
