---
import Tag from "./Tag.astro";
import type { Project } from "../lib/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, year, status, tech, repo, demo, draft } = project.data;
const href = `/projects/${project.id}`;
---

<article class="project">
  <div class="head">
    <h3>
      <a href={href}>{title}</a>
      {draft && <span class="draft">Draft</span>}
    </h3>
    <span class="year">{year}</span>
  </div>

  <p class="status">{status}</p>
  <p class="desc">{description}</p>

  {tech.length > 0 && (
    <div class="tech">
      {tech.map((t) => <Tag label={t} />)}
    </div>
  )}

  <div class="links">
    <a href={href}>Read more</a>
    {repo && <a href={repo} target="_blank" rel="noopener">Source</a>}
    {demo && <a href={demo} target="_blank" rel="noopener">Demo</a>}
  </div>
</article>

<style>
  .project {
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--rule);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }

  h3 {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .draft {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.05rem 0.3rem;
  }

  .year {
    font-size: 0.78rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .status {
    margin-top: 0.2rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .desc {
    margin-top: 0.6rem;
    max-width: 54rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: var(--space-xs);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: var(--space-s);
    font-size: 0.85rem;
  }

  .links a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }

  .links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
