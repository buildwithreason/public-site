---
import type { Adjacent } from "../lib/content";

interface Props {
  adjacent: Adjacent;
}

const { adjacent } = Astro.props;
const { newer, older } = adjacent;
---

{(newer || older) && (
  <nav class="post-nav" aria-label="More writing">
    {older ? (
      <a class="prev" href={`/writing/${older.id}`} rel="prev">
        <span class="label">Older</span>
        <span class="title">{older.data.title}</span>
      </a>
    ) : <span />}

    {newer && (
      <a class="next" href={`/writing/${newer.id}`} rel="next">
        <span class="label">Newer</span>
        <span class="title">{newer.data.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--rule);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  a:hover {
    border-color: var(--rule-strong);
  }

  .next {
    text-align: right;
  }

  .label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .title {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }

  a:hover .title {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .next {
      text-align: left;
    }
  }
</style>
