---
interface Props {
  title: string;
  /** Optional link rendered on the right, e.g. "All writing →". */
  href?: string;
  linkLabel?: string;
  as?: "h2" | "h3";
}
const { title, href, linkLabel = "View all", as: Heading = "h2" }: Props = Astro.props;
---

<div class="section-heading">
  <Heading class="eyebrow">{title}</Heading>
  {href && <a href={href}>{linkLabel} <span aria-hidden="true">&rarr;</span></a>}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: var(--space-m);
  }

  a {
    font-size: 0.82rem;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    color: var(--accent);
  }
</style>
