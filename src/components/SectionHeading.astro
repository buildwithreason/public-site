---
interface Props {
  title: string;
  /** Optional link shown under the label, e.g. "All writing →". */
  href?: string;
  linkLabel?: string;
  as?: "h2" | "h3";
}
const { title, href, linkLabel = "View all", as: Heading = "h2" }: Props = Astro.props;
---

<div class="section-label">
  <Heading class="eyebrow">{title}</Heading>
  {href && <a href={href}>{linkLabel} <span aria-hidden="true">&rarr;</span></a>}
</div>

<style>
  .section-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--rule-strong);
  }

  a {
    font-size: 0.82rem;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    color: var(--accent);
  }

  /* In the rail the label stacks and loses its rule — the content column
     carries the divider instead, so the two align across the gap. */
  @media (min-width: 74rem) {
    .section-label {
      display: block;
      padding-bottom: 0;
      border-bottom: 0;
      position: sticky;
      top: var(--space-l);
    }

    a {
      display: inline-block;
      margin-top: 0.5rem;
    }
  }
</style>
