---
// Command palette over the writing index. Uses a native <dialog>, so focus
// trapping, Escape handling and inertness of the page behind come from the
// platform rather than from script.
---

<button id="search-open" type="button" class="search-trigger no-print" aria-label="Search writing">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="10.5" cy="10.5" r="6.5"></circle>
    <path d="M15.5 15.5 21 21"></path>
  </svg>
  <span class="hint"><kbd>⌘</kbd><kbd>K</kbd></span>
</button>

<dialog id="search-dialog" aria-label="Search writing">
  <form method="dialog" class="field">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="field-icon">
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <path d="M15.5 15.5 21 21"></path>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="Search writing…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="search-results"
    />
    <button value="close" class="esc" aria-label="Close search"><kbd>Esc</kbd></button>
  </form>

  <div id="search-results" role="listbox" aria-label="Results"></div>
  <p class="foot"><kbd>↑</kbd><kbd>↓</kbd> to navigate · <kbd>↵</kbd> to open</p>
</dialog>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .search-trigger:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .search-trigger svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1;
    padding: 0.15rem 0.25rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-faint);
  }

  .hint {
    display: flex;
    gap: 0.15rem;
  }

  @media (max-width: 34rem) {
    .hint { display: none; }
  }

  dialog {
    width: min(38rem, calc(100vw - 2rem));
    /* The global `* { margin: 0 }` reset overrides the UA stylesheet's
       `dialog { margin: auto }`, which is what centres a modal against its
       `inset: 0`. Without this the dialog pins to the left edge. */
    margin-inline: auto;
    margin-top: 12vh;
    padding: 0;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(2px);
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .field-icon {
    width: 1rem;
    height: 1rem;
    flex: none;
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink);
    outline: none;
  }

  input::-webkit-search-cancel-button { display: none; }

  .esc {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  #search-results {
    max-height: min(24rem, 55vh);
    overflow-y: auto;
    padding: 0.35rem;
  }

  #search-results :global(.result) {
    display: block;
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
  }

  #search-results :global(.result[aria-selected="true"]) {
    background: var(--bg-inset);
  }

  #search-results :global(.result-title) {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.3;
    color: var(--ink);
  }

  #search-results :global(.result[aria-selected="true"] .result-title) {
    color: var(--accent);
  }

  #search-results :global(.result-meta) {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    color: var(--ink-faint);
  }

  #search-results :global(.empty) {
    padding: 1.2rem 0.6rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.9rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  @media (max-width: 34rem) {
    .foot { display: none; }
  }
</style>

<script>
  const openBtn = document.getElementById("search-open") as HTMLButtonElement | null;
  const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const results = document.getElementById("search-results");

  if (openBtn && dialog && input && results) {
    type Entry = {
      title: string; description: string; category: string; tags: string[];
      url: string; date: string; readingTime: string; body: string;
    };

    let index: Entry[] | null = null;
    let loading = false;
    let selected = 0;
    let current: Entry[] = [];

    // The index is only fetched the first time the palette is opened.
    async function ensureIndex() {
      if (index || loading) return;
      loading = true;
      try {
        index = await fetch("/search.json").then((r) => r.json());
      } catch {
        index = [];
      } finally {
        loading = false;
        render(input!.value);
      }
    }

    /** Field-weighted substring scoring: a title hit beats a body hit. */
    function score(entry: Entry, q: string): number {
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) return 0;

      let total = 0;
      for (const term of terms) {
        let best = 0;
        if (entry.title.toLowerCase().includes(term)) best = 10;
        else if (entry.tags.some((t) => t.toLowerCase().includes(term))) best = 6;
        else if (entry.category.toLowerCase().includes(term)) best = 5;
        else if (entry.description.toLowerCase().includes(term)) best = 3;
        else if (entry.body.toLowerCase().includes(term)) best = 1;
        if (!best) return 0; // every term must match somewhere
        total += best;
      }
      return total;
    }

    function render(q: string) {
      const query = q.trim();

      if (!index) {
        results!.innerHTML = `<p class="empty">Loading…</p>`;
        return;
      }

      current = query
        ? index
            .map((e) => ({ e, s: score(e, query) }))
            .filter((x) => x.s > 0)
            .sort((a, b) => b.s - a.s || b.e.date.localeCompare(a.e.date))
            .slice(0, 8)
            .map((x) => x.e)
        : index.slice(0, 5);

      selected = 0;

      if (!current.length) {
        results!.innerHTML = `<p class="empty">No writing matches “${query.replace(/[<&]/g, "")}”.</p>`;
        return;
      }

      results!.innerHTML = current
        .map(
          (e, i) => `<a class="result" role="option" href="${e.url}" aria-selected="${i === 0}">
            <span class="result-title">${e.title}</span>
            <span class="result-meta">${e.category} · ${e.readingTime}</span>
          </a>`
        )
        .join("");
    }

    function move(delta: number) {
      if (!current.length) return;
      const nodes = results!.querySelectorAll<HTMLElement>(".result");
      nodes[selected]?.setAttribute("aria-selected", "false");
      selected = (selected + delta + current.length) % current.length;
      const next = nodes[selected];
      next?.setAttribute("aria-selected", "true");
      next?.scrollIntoView({ block: "nearest" });
    }

    function open() {
      dialog!.showModal();
      input!.value = "";
      render("");
      ensureIndex();
      input!.focus();
    }

    openBtn.addEventListener("click", open);

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        dialog!.open ? dialog!.close() : open();
      }
    });

    input.addEventListener("input", () => render(input.value));

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
      else if (e.key === "Enter") {
        const target = current[selected];
        if (target) { e.preventDefault(); window.location.href = target.url; }
      }
    });
  }
</script>
