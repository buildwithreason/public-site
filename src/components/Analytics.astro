---
import { siteConfig } from "../config/site";

// No token, no script. The site ships zero analytics by default.
const token = siteConfig.analytics.cloudflareToken;
---

{token && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token })}
  />
)}
