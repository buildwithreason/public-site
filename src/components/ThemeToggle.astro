---
// The only interactive JavaScript on the site. Roughly 20 lines, no dependencies.
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle no-print"
  aria-label="Switch between light and dark theme"
  title="Switch theme"
>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.4M12 19v2.4M4.2 12H1.8M22.2 12h-2.4M6.5 6.5 4.8 4.8M19.2 19.2l-1.7-1.7M17.5 6.5l1.7-1.7M4.8 19.2l1.7-1.7"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--rule);
  }

  .icon {
    grid-area: 1 / 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the icon for the theme you would switch TO. */
  .moon { display: none; }

  :global(:root[data-theme="dark"]) .moon { display: block; }
  :global(:root[data-theme="dark"]) .sun { display: none; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .moon { display: block; }
    :global(:root:not([data-theme="light"])) .sun { display: none; }
  }
</style>

<script>
  const KEY = "theme";
  const root = document.documentElement;

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.dataset.theme ?? (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";

    root.dataset.theme = next;
    // Clear the override when the choice matches the system, so the site
    // follows the OS again if that setting later changes.
    if ((next === "dark") === systemDark) {
      localStorage.removeItem(KEY);
      delete root.dataset.theme;
    } else {
      localStorage.setItem(KEY, next);
    }
  });
</script>
