---
import { siteConfig } from "../config/site";
import SocialLinks from "./SocialLinks.astro";
---

<section class="hero">
  <div class="wrap">
    {/* The person is the h1. The tagline is the claim made underneath it —
        prominent, but never competing with the name for first read. */}
    <h1 class="name">{siteConfig.name}</h1>
    <p class="role">{siteConfig.role} at {siteConfig.company}</p>

    <p class="disciplines">{siteConfig.disciplines.join(" · ")}</p>

    <p class="tagline">{siteConfig.tagline}</p>

    <div class="actions">
      <a class="primary" href="/writing">Read the writing</a>
      <a class="secondary" href="/projects">Explore projects</a>
    </div>

    <SocialLinks />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 7vw, 7rem);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }

  .name {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.028em;
    color: var(--ink);
  }

  .role {
    margin-top: var(--space-xs);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink-secondary);
  }

  .disciplines {
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Clearly subordinate to the name, but still the largest body text on the
     page — it is the sentence the whole site exists to argue. */
  .tagline {
    margin-top: var(--space-s);
    max-width: 34ch;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.32;
    letter-spacing: -0.008em;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
    margin-bottom: var(--space-m);
  }

  .actions a {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .primary:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .secondary {
    color: var(--ink-secondary);
  }

  .secondary:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 34rem) {
    .tagline {
      max-width: none;
    }
  }
</style>
