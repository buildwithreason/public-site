---
/**
 * Reading progress for every page.
 *
 * Measures document scroll rather than a designated article body. The earlier
 * article-only version measured the prose container, which meant it read 0%
 * whenever that container was shorter than the viewport — correct in theory,
 * but indistinguishable from broken. Document scroll always has an answer, and
 * it is the same answer on every page.
 *
 * On a page with nothing to scroll the bar stays at zero width, so it is
 * simply invisible rather than needing to be conditionally rendered.
 */
---

<div class="scroll-progress" aria-hidden="true"><span data-progress></span></div>

<style>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    /* Above the header, which is not itself sticky but sits at the top. */
    z-index: 50;
    background: transparent;
    pointer-events: none;
  }

  .scroll-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.08s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress span {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-progress]");

  if (bar) {
    const update = () => {
      const doc = document.documentElement;
      const span = doc.scrollHeight - window.innerHeight;
      const pct = span > 0 ? Math.min(1, Math.max(0, window.scrollY / span)) : 0;
      bar.style.width = `${pct * 100}%`;
    };

    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update, { passive: true });
    // Late-loading content (fonts, the comments iframe) changes the page height.
    if ("ResizeObserver" in window) {
      new ResizeObserver(update).observe(document.documentElement);
    }
  }
</script>
