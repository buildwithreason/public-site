---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// h1 is the article title and h4+ is too fine-grained to navigate by.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

// A contents list is noise on a piece with only a couple of sections.
const show = items.length >= 3;
---

{show && (
  <nav class="toc" aria-label="Article contents" data-toc>
    <p class="toc-title eyebrow">Contents</p>
    <ol>
      {items.map((h) => (
        <li class:list={["toc-item", `depth-${h.depth}`]}>
          <a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .toc-title {
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-xs);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item + .toc-item {
    margin-top: 0.1rem;
  }

  .depth-3 a {
    padding-left: 0.85rem;
    font-size: 0.76rem;
  }

  a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.6rem;
    color: var(--ink-muted);
    text-decoration: none;
    border-left: 2px solid var(--rule);
    transition: color 0.15s ease, border-color 0.15s ease;
    text-wrap: pretty;
  }

  a:hover {
    color: var(--ink);
    border-left-color: var(--rule-strong);
  }

  /* Set by the scroll spy in ArticleLayout. */
  a[aria-current="true"] {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* On narrow screens the rail becomes a collapsed summary above the article. */
  @media (max-width: 74rem) {
    .toc {
      margin-bottom: var(--space-l);
      padding: var(--space-s) var(--space-m);
      background: var(--bg-surface);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    ol {
      columns: 2;
      column-gap: var(--space-m);
    }

    .toc-item {
      break-inside: avoid;
    }
  }

  @media (max-width: 34rem) {
    ol {
      columns: 1;
    }
  }
</style>
