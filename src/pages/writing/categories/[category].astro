---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getArticles, slugify } from "../../../lib/content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const articles = await getArticles();
  const groups = new Map<string, { name: string; posts: typeof articles }>();

  for (const article of articles) {
    const slug = slugify(article.data.category);
    const group = groups.get(slug) ?? { name: article.data.category, posts: [] };
    group.posts.push(article);
    groups.set(slug, group);
  }

  return [...groups.entries()].map(([slug, group]) => ({
    params: { category: slug },
    props: { name: group.name, posts: group.posts },
  }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props;
---

<BaseLayout
  title={name}
  description={`Writing on ${name} — ${posts.length} ${posts.length === 1 ? "piece" : "pieces"} on how these systems actually work.`}
>
  <div class="wrap">
    <header class="page-header measure">
      <p class="eyebrow"><a href="/writing/tags">Pillar</a></p>
      <h1>{name}</h1>
      <p class="count">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
    </header>

    {posts.map((post) => <ArticleCard article={post} />)}

    <p class="back"><a href="/writing">&larr; All writing</a></p>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--rule-strong);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .count {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .back {
    margin-top: var(--space-l);
    font-size: 0.875rem;
  }

  .back a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }
</style>
