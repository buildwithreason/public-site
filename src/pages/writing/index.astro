---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import TopicNav from "../../components/TopicNav.astro";
import { getArticles } from "../../lib/content";

const articles = await getArticles();
const count = articles.length;
---

<BaseLayout
  title="Writing"
  description="Essays on software engineering, distributed systems, cloud architecture and AI — and the reasoning behind the decisions."
>
  <div class="wrap">
    <header class="page-header railed">
      <p class="eyebrow">Writing</p>
      <div class="railed-body plain">
        <h1>Essays on how modern software actually works</h1>
        <p class="standfirst">
          Long-form pieces on software engineering, distributed systems, cloud architecture and
          AI. Roughly one substantial article a week.
        </p>
      </div>
    </header>

    <TopicNav active="all" />

    {count > 0 ? (
      <section aria-label="All articles">
        {articles.map((article) => <ArticleCard article={article} />)}
      </section>
    ) : (
      <p class="empty">No articles published yet.</p>
    )}

    <p class="feed">
      Subscribe via <a href="/rss.xml">RSS</a>, or see <a href="/writing/tags">every topic</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--rule-strong);
  }

  h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 54rem;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .empty {
    padding-block: var(--space-l);
    color: var(--ink-muted);
  }

  .feed {
    margin-top: var(--space-l);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .feed a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }
</style>
