---
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../config/now";
import { formatDate } from "../lib/content";

const updated = formatDate(new Date(now.updated));
---

<BaseLayout
  title="Now"
  description="What I am building, writing about and thinking about at the moment."
>
  <div class="wrap">
    <header class="page-header railed">
      <p class="eyebrow">Now</p>
      <div class="railed-body plain">
        <h1>What I'm doing now</h1>
        <p class="standfirst">{now.intro}</p>
        <p class="updated">Last updated {updated}</p>
      </div>
    </header>

    <div class="sections">
      {now.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <p class="colophon measure">
      This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a> — a snapshot of current focus rather than a changelog.
    </p>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--rule);
  }

  h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 54rem;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .updated {
    margin-top: var(--space-s);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  /* Three short lists stacked in one 39rem column left most of the page
     empty. As a column grid they are all visible at once. */
  .sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l) var(--space-xl);
    align-items: start;
    max-width: none;
  }

  @media (min-width: 62rem) {
    .sections {
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    }
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
  }

  ul {
    margin-top: var(--space-s);
    padding-left: 1.1rem;
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.68;
    color: var(--ink-secondary);
  }

  li + li {
    margin-top: 0.55rem;
  }

  li::marker {
    color: var(--ink-faint);
  }

  .colophon {
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .colophon a {
    color: var(--ink-muted);
  }
</style>
