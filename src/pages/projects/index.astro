---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/content";

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Systems, experiments and reference implementations — with the engineering problem, the architecture and the trade-offs written down."
>
  <div class="wrap">
    <header class="page-header railed">
      <p class="eyebrow">Projects</p>
      <div class="railed-body plain">
        <h1>Things I have built, and what they taught me</h1>
        <p class="standfirst">
          Each entry covers the engineering problem, the architecture, the decisions that were
          genuinely contested, and what I would do differently.
        </p>
      </div>
    </header>

    {projects.length > 0 ? (
      <section aria-label="All projects">
        {projects.map((project) => <ProjectCard project={project} />)}
      </section>
    ) : (
      <p class="empty">No projects published yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--rule-strong);
  }

  h1 {
    margin-top: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .standfirst {
    margin-top: var(--space-s);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 54rem;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .empty {
    padding-block: var(--space-l);
    color: var(--ink-muted);
  }
</style>
