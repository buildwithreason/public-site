# Cloudflare header rules. Honoured by both Pages and Workers static assets;
# this site is currently served by Workers.
# Hashed asset paths and vendored fonts never change contents, so they can be
# cached indefinitely. HTML must revalidate so a new article appears immediately.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
